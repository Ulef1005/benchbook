---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const examples = [
  { kicker: "Ingest", title: "You saw a funky ESP32 project and want to build it",
    body: "The video becomes a source page with the transcript embedded. The build becomes a separate project page — and nothing gets written until you've approved a plan.", cmd: "/wiki-ingest" },
  { kicker: "Decide", title: "You want a self-hosted bot, but don't know which repo",
    body: "Research four candidates, record why the most popular one lost, then deploy with seven boring integration steps pre-filled and unticked.", cmd: "/project-open" },
  { kicker: "Learn", title: "You want to learn to fly FPV drones",
    body: "A learning path with gates between phases, a price baseline before you shop, and every gear option you rejected, with your reasoning, dated.", cmd: "/project-open" },
];

const recall = [
  { q: "How was it built?", a: "Which stack, which wiring, which of the four config files is the live one." },
  { q: "When, and what since?", a: "Dated, in git, with a change history on anything whose state actually moves." },
  { q: "Why that way?", a: "Including the options you considered and dropped, and what ruled each one out." },
];
---
<Base title="benchbook">
  <section class="hero">
    <div>
      <div class="eyebrow">A markdown wiki, in git, kept by an agent</div>
      <h1>Your AI keeps the wiki.<br /><span>You keep the rules.</span></h1>
      <p class="lead">The code survives. The reasoning doesn't. benchbook is a plain markdown wiki
        maintained by an AI agent under a written contract — a file it reads at every session start
        that says what it may create, what it must ask about, and what it may never touch.</p>
      <div class="cta">
        <a class="primary" href={`${base}/docs/day-in-the-life/`}>Read the docs →</a>
        <a class="secondary" href={`${base}/wiki/`}>Browse the demo wiki</a>
      </div>
      <p class="fine">No app. No database. No embeddings. Just files an agent is disciplined about.</p>
    </div>

    <div class="terminal" aria-hidden="true">
      <div class="dots"><i></i><i></i><i></i></div>
      <div><span class="dim">$</span> /wiki-ingest https://youtu.be/…</div>
      <div class="dim">→ source page drafted · transcript embedded</div>
      <div class="dim">→ 2 entities proposed <span class="neon">(awaiting approval)</span></div>
      <div class="dim">→ project page? <span class="bright">y</span></div>
      <div class="gap"></div>
      <div><span class="dim">$</span> /wiki-lint</div>
      <div class="dim">→ 4 pages checked · 3 findings</div>
      <div class="dim">→ written to todo.md</div>
    </div>
  </section>

  <section class="band">
    <h2>See it work</h2>
    <p class="sub">Three ordinary tasks, walked step by step in
      <a href={`${base}/docs/day-in-the-life/`}>A Day in the Life</a>.</p>
    <div class="cards">
      {examples.map((ex) => (
        <a class="card" href={`${base}/docs/day-in-the-life/`}>
          <span class="kicker">{ex.kicker}</span>
          <span class="t">{ex.title}</span>
          <span class="b">{ex.body}</span>
          <span class="cmd">{ex.cmd}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="band">
    <p class="quote">“Why did I pick that library three months ago?”</p>
    <div class="recall">
      {recall.map((r) => (<div><b>{r.q}</b><span>{r.a}</span></div>))}
    </div>
    <p class="after">A README captures the first. Git captures the second. Almost nothing captures
      the third — and the third is the one you actually miss.</p>
  </section>

  <footer class="site">
    <svg viewBox="0 0 100 100" width="16" height="16" aria-hidden="true">
      <rect x="18" y="24" width="64" height="11" fill="currentColor" />
      <polygon points="50,35 27,76 73,76" fill="currentColor" />
    </svg>
    <span>benchbook — MIT. An instantiation of Karpathy's LLM Wiki pattern.</span>
    <span class="right">Built with Astro · published on GitHub Pages</span>
  </footer>
</Base>

<style>
  section { max-width: 1180px; margin: 0 auto; padding: 0 1.625rem; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 3.5rem; align-items: center; padding-top: 5.25rem; padding-bottom: 4.75rem; }
  h1 { font-size: 3.25rem; line-height: 1.08; letter-spacing: -0.025em; margin: 1.625rem 0; text-wrap: balance; }
  h1 span { color: var(--neon); }
  .lead { font-size: 1.0625rem; color: var(--fg-muted); max-width: 52ch; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; font-family: var(--mono); font-size: 0.8125rem; margin: 1.625rem 0; }
  .cta a { text-decoration: none; padding: 0.8125rem 1.25rem; border-radius: var(--radius); }
  .primary { background: var(--fg); color: var(--bg); }
  .secondary { border: 1px solid var(--fg); }
  .fine { font-family: var(--mono); font-size: 0.75rem; color: var(--fg-faint); margin: 0; }

  .terminal { background: var(--graphite); color: var(--paper); border-radius: 3px;
    padding: 1.375rem; font-family: var(--mono); font-size: 0.78rem; line-height: 1.85;
    box-shadow: 0 24px 50px -30px rgba(33,32,28,0.9); }
  .terminal .dots { display: flex; gap: 0.375rem; margin-bottom: 1rem; }
  .terminal i { width: 8px; height: 8px; border-radius: 50%; background: #4A463E; }
  .terminal i:first-child { background: var(--neon); }
  .terminal .dim { color: #8A8377; }
  .terminal .neon { color: var(--neon); }
  .terminal .bright { color: var(--paper); }
  .terminal .gap { height: 0.875rem; }

  .band { border-top: 1px solid var(--rule); padding-top: 3.75rem; padding-bottom: 4rem; }
  .band h2 { margin: 0 0 0.5rem; font-size: 1.375rem; }
  .sub { color: var(--fg-faint); margin-bottom: 2rem; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.125rem; }
  .card { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.375rem;
    border: 1px solid var(--rule); border-radius: 3px; background: var(--bg-raised); text-decoration: none; }
  .card:hover { border-color: var(--fg); color: var(--fg); }
  .kicker { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--neon); }
  .card .t { font-family: var(--mono); font-size: 1rem; font-weight: 500; line-height: 1.35; }
  .card .b { font-size: 0.875rem; color: var(--fg-muted); }
  .card .cmd { font-family: var(--mono); font-size: 0.75rem; color: var(--fg-faint); margin-top: auto; }

  .quote { font-family: var(--mono); font-size: 1.625rem; font-weight: 500;
    letter-spacing: -0.02em; line-height: 1.35; max-width: 30ch; margin: 0 0 2.125rem; }
  .recall { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .recall div { display: flex; flex-direction: column; gap: 0.5rem;
    padding-left: 1rem; border-left: 2px solid var(--neon); }
  .recall b { font-family: var(--mono); font-size: 0.9375rem; font-weight: 500; }
  .recall span { font-size: 0.875rem; color: var(--fg-muted); }
  .after { margin-top: 1.75rem; max-width: 62ch; color: var(--fg-muted); }

  .site { border-top: 1px solid var(--rule); background: var(--bg-sunk);
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
    padding: 1.625rem; font-family: var(--mono); font-size: 0.75rem; color: var(--fg-faint); }
  .site .right { margin-left: auto; }

  @media (max-width: 900px) {
    .hero, .cards, .recall { grid-template-columns: minmax(0, 1fr); }
    h1 { font-size: 2.5rem; }
  }
</style>
