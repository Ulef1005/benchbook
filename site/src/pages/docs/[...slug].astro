---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const docs = (await getCollection("docs")).sort((a, b) => a.id.localeCompare(b.id));
  const label = (e: typeof docs[number]) =>
    e.data.title ?? e.id.replace(/^(\d+)-/, "$1 — ").replace(/-/g, " ");
  return docs.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? { label: label(docs[i - 1]), href: `/docs/${docs[i - 1].id}/` } : undefined,
      next: i < docs.length - 1 ? { label: label(docs[i + 1]), href: `/docs/${docs[i + 1].id}/` } : undefined,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const title = entry.data.title ?? headings.find((h) => h.depth === 1)?.text ?? entry.id;
const n = Number(entry.id.match(/^(\d+)/)?.[1] ?? NaN);
const group = Number.isNaN(n) ? "Start here" : n <= 7 ? "Foundations" : n <= 12 ? "In practice" : "Caveats";
---
<DocsLayout
  title={title}
  crumbs={["Docs", group, title]}
  headings={headings}
  repoPath={`docs/${entry.id}.md`}
  prev={prev}
  next={next}
>
  <Content />
</DocsLayout>
