---
// Pagefind runs post-build over dist/, so the bundle only exists in a real build:
// in `astro dev` the dialog reports "search index not built yet". That is expected.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<button id="search-open" type="button">
  <span>Search</span><kbd>/</kbd>
</button>

<dialog id="search-dialog" aria-label="Search">
  <div class="panel">
    <div id="pagefind"></div>
    <footer><span>↑↓ navigate</span><span>↵ open</span><span class="hint">Docs · Wiki · Contract</span></footer>
  </div>
</dialog>

<script is:inline define:vars={{ base }}>
  const dialog = document.getElementById("search-dialog");
  const open = document.getElementById("search-open");
  let booted = false;

  async function boot() {
    if (booted) return;
    booted = true;
    try {
      const { PagefindUI } = await import(`${base}/pagefind/pagefind-ui.js`);
      new PagefindUI({
        element: "#pagefind", showImages: false, pageSize: 6, showSubResults: true,
        translations: { placeholder: "Search the docs and wiki" },
      });
    } catch {
      document.getElementById("pagefind").innerHTML =
        '<p class="mono" style="padding:1rem;color:var(--fg-faint)">Search index not built yet — run <code>npm run build</code>.</p>';
    }
  }

  open?.addEventListener("click", () => { boot(); dialog.showModal(); });
  addEventListener("keydown", (e) => {
    if (e.key === "/" && !/^(INPUT|TEXTAREA)$/.test(document.activeElement?.tagName ?? "")) {
      e.preventDefault(); boot(); dialog.showModal();
    }
  });
  dialog?.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
</script>

<style is:global>
  #search-open { display: flex; align-items: center; gap: 2.5rem; min-width: 150px;
    border: 1px solid var(--rule); border-radius: var(--radius); background: none;
    font: inherit; font-family: var(--mono); font-size: 0.75rem; color: var(--fg-faint);
    padding: 0.375rem 0.625rem; cursor: pointer; }
  #search-open:hover { border-color: var(--fg); }
  #search-open kbd { border: 1px solid var(--rule); border-radius: var(--radius);
    padding: 0 0.25rem; font-size: 0.625rem; margin-left: auto; }
  #search-dialog { border: none; padding: 0; background: none; max-width: 680px; width: 92vw; margin-top: 8vh; }
  #search-dialog::backdrop { background: rgba(20, 19, 16, 0.62); }
  #search-dialog .panel { background: var(--bg-sunk); border: 1px solid var(--rule);
    border-radius: 3px; box-shadow: 0 30px 60px -30px rgba(0,0,0,0.6); overflow: hidden; }
  #search-dialog footer { display: flex; gap: 1.125rem; padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--rule); font-family: var(--mono); font-size: 0.65rem; color: var(--fg-faint); }
  #search-dialog .hint { margin-left: auto; }

  /* Pagefind UI, dressed to match the design */
  :root { --pagefind-ui-primary: var(--fg); --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg-sunk); --pagefind-ui-border: var(--rule);
    --pagefind-ui-tag: var(--bg-raised); --pagefind-ui-border-radius: 2px;
    --pagefind-ui-font: var(--sans); --pagefind-ui-border-width: 1px; }
  .pagefind-ui__search-input { font-family: var(--mono) !important; font-size: 1.0625rem !important; }
  .pagefind-ui__result-title { font-family: var(--mono); font-size: 0.9375rem; }
  .pagefind-ui__result-title a { text-decoration: none; }
  .pagefind-ui__result { border-top: 1px solid var(--rule); padding: 0.75rem 0; }
  .pagefind-ui__result:hover { background: var(--bg-raised); }
  .pagefind-ui__result-excerpt { font-size: 0.85rem; color: var(--fg-muted); }
  .pagefind-ui__result mark { background: none; color: var(--neon); font-weight: 500; }
  .pagefind-ui__message { font-family: var(--mono); font-size: 0.65rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-faint); }
</style>
