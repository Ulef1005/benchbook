---
const { types } = Astro.props as { types: string[] };
---
<div class="filters" role="group" aria-label="Filter by page type">
  <button type="button" data-type="all" class="on">All</button>
  {types.map((t) => <button type="button" data-type={t}>{t}</button>)}
</div>

<script is:inline>
  // Client-side, no reload: index pages are small and the filter should feel instant.
  const bar = document.querySelector(".filters");
  bar?.addEventListener("click", (e) => {
    const btn = e.target.closest("button");
    if (!btn) return;
    bar.querySelectorAll("button").forEach((b) => b.classList.toggle("on", b === btn));
    const want = btn.dataset.type;
    let shown = 0;
    document.querySelectorAll("[data-entry-type]").forEach((row) => {
      const hit = want === "all" || row.dataset.entryType === want;
      row.hidden = !hit;
      if (hit) shown++;
    });
    const count = document.querySelector("[data-entry-count]");
    if (count) count.textContent = count.dataset.entryCountTemplate.replace("{n}", String(shown));
  });
</script>

<style>
  .filters { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 0 0 1.375rem;
    font-family: var(--mono); font-size: 0.75rem; }
  button { border: 1px solid var(--rule); border-radius: var(--radius); background: none;
    color: var(--fg-muted); font: inherit; padding: 0.375rem 0.75rem; cursor: pointer;
    text-transform: capitalize; }
  button:hover { border-color: var(--fg); }
  button.on { background: var(--fg); color: var(--bg); border-color: var(--fg); }
</style>
