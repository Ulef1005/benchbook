---
import ThemeToggle from "./ThemeToggle.astro";
import Search from "./Search.astro";
const { section } = Astro.props as { section?: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const nav = [
  { label: "Docs", href: `${base}/docs/day-in-the-life/`, key: "docs" },
  { label: "The wiki", href: `${base}/wiki/`, key: "wiki" },
  { label: "Domains", href: `${base}/domains/`, key: "domains" },
  { label: "Contract", href: `${base}/contract/agents-core/`, key: "contract" },
];
---
<header>
  <a class="brand" href={`${base}/`}>
    <svg viewBox="0 0 100 100" width="20" height="20" aria-hidden="true">
      <rect x="18" y="24" width="64" height="11" fill="#FF3DBE" />
      <polygon points="50,35 27,76 73,76" fill="#FF3DBE" />
    </svg>
    <span>benchbook</span>
  </a>
  <nav aria-label="Sections">
    {nav.map((n) => <a href={n.href} class:list={["nav-link", { current: section === n.key }]}>{n.label}</a>)}
  </nav>
  <div class="right">
    <Search />
    <ThemeToggle />
    <a class="gh" href="https://github.com/Ulef1005/benchbook">GitHub</a>
  </div>
</header>

<style>
  header {
    position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 1.375rem;
    height: 56px; padding: 0 1.625rem; background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px); border-bottom: 1px solid var(--rule); font-family: var(--mono);
  }
  .brand { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; font-weight: 500;
           letter-spacing: -0.01em; text-decoration: none; }
  nav { display: flex; gap: 1.375rem; font-size: 0.8125rem; }
  .nav-link { color: var(--fg-muted); text-decoration: none; padding-bottom: 2px; }
  .nav-link.current { color: var(--fg); border-bottom: 1px solid var(--neon); }
  .right { margin-left: auto; display: flex; align-items: center; gap: 0.625rem; }
  .gh { font-size: 0.75rem; color: var(--fg-muted); text-decoration: none;
        border: 1px solid var(--rule); border-radius: var(--radius); padding: 0.375rem 0.625rem; }
  .gh:hover { border-color: var(--fg); }
  @media (max-width: 760px) { nav { display: none; } }
</style>
