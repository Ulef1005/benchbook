---
const { headings } = Astro.props as { headings: { depth: number; slug: string; text: string }[] };
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 0 && (
  <aside class="toc">
    <div class="eyebrow">On this page</div>
    <nav>
      {items.map((h) => <a href={`#${h.slug}`} data-depth={h.depth}>{h.text}</a>)}
    </nav>
  </aside>
)}

<style>
  .toc { border-left: 1px solid var(--rule); padding: 2.5rem 1.125rem;
    font-family: var(--mono); font-size: 0.75rem; position: sticky; top: 56px;
    max-height: calc(100vh - 56px); overflow-y: auto; }
  .toc .eyebrow { margin-bottom: 0.75rem; }
  nav { display: flex; flex-direction: column; gap: 0.5rem; }
  a { color: var(--fg-faint); text-decoration: none; border-left: 2px solid transparent; padding-left: 0.5rem; }
  a[data-depth="3"] { padding-left: 1.25rem; }
  a:hover, a.active { color: var(--fg); }
  a.active { border-left-color: var(--neon); }
  @media (max-width: 1100px) { .toc { display: none; } }
</style>

<script is:inline>
  const links = [...document.querySelectorAll(".toc a")];
  if (links.length) {
    const seen = new Map();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => seen.set(e.target.id, e.isIntersecting));
      const first = links.find((l) => seen.get(l.hash.slice(1)));
      links.forEach((l) => l.classList.toggle("active", l === first));
    }, { rootMargin: "-72px 0px -70% 0px" });
    links.forEach((l) => {
      const el = document.getElementById(decodeURIComponent(l.hash.slice(1)));
      if (el) io.observe(el);
    });
  }
</script>
