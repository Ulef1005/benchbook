---
---
<button id="theme-toggle" type="button" aria-label="Switch theme">
  <span data-light>☀</span><span data-dark>☾</span>
</button>

<script is:inline>
  // Runs before paint in Base.astro's head; this block only wires the click.
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const now = root.dataset.theme ||
      (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    const next = now === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem("benchbook-theme", next);
  });
</script>

<style>
  button { display: flex; border: 1px solid var(--rule); border-radius: var(--radius);
           background: none; padding: 0; font: inherit; font-size: 0.6875rem; cursor: pointer; overflow: hidden; }
  span { padding: 0.375rem 0.5rem; color: var(--fg-faint); }
  :root:not([data-theme="dark"]) [data-light],
  :root[data-theme="light"] [data-light] { background: var(--graphite); color: var(--paper); }
  :root[data-theme="dark"] [data-dark] { background: var(--paper); color: var(--graphite); }
  :root[data-theme="dark"] [data-light] { background: none; color: var(--fg-faint); }
</style>
