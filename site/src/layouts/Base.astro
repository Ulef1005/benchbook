---
const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title ? `${title} — benchbook` : 'benchbook'}</title>
	</head>
	<body>
		<header>
			<a href="/benchbook/">benchbook</a>
			<!-- Unstyled on purpose — this scaffold is functional first, real design lands via
			     the benchbook-design skill once it exists. See Phase 6 on the wiki project page. -->
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>
